# ── База данных (обязательно) ──────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Файловое хранилище ─────────────────────────────────────
# local — приватная папка на диске (вне public/), файлы отдаются только
#         через API после проверки прав.
# s3    — S3-совместимое хранилище (MinIO/AWS/SeaweedFS), скачивание
#         через presigned-URL приватного бакета.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage

# ── S3 (только при STORAGE_DRIVER=s3) ──────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=setka
S3_FORCE_PATH_STYLE=1
S3_PRESIGN_TTL=60

# ── Прочее ─────────────────────────────────────────────────
# Разрешить небезопасную cookie поверх http в production-сборке
# (только для стенда; в боевом проде должен быть HTTPS).
# INSECURE_COOKIE=1
